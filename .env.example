# API
PORT=4000
HOST=0.0.0.0
NODE_ENV=development

# Optional. Comma-separated browser origins allowed to call the API.
# Unset locally to allow any origin.
# Production example: https://your-web-host.example,http://localhost:3000
# CORS_ORIGIN=

# Betway Nigeria operator configuration
BETWAY_BASE_URL=https://www.betway.com.ng
BETWAY_BRAND_ID=f8a8d16a-d619-4b49-aa8c-f21211403c92
BETWAY_COUNTRY_CODE=NG
BETWAY_CULTURE_CODE=en-US
BETWAY_TIMEOUT_MS=8000

# Database (canonical slip snapshots and conversion audits)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/matchcorner

# Web (inlined at next build; do not point production at localhost)
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
